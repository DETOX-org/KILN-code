# Backend Port
PORT=3000

# PostgreSQL Database URL
# For local Docker Compose: postgresql://kiln:kiln_dev_password@localhost:5433/kiln
# For cloud database (Neon/Supabase/Render): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://kiln:kiln_dev_password@localhost:5433/kiln

# Redis URL (Used for submission queuing)
# For local Docker Compose: redis://localhost:6379
# For cloud Redis (Upstash): rediss://default:password@endpoint:6379
REDIS_URL=redis://localhost:6379

# Judge Service URL (Compiler Sandbox HTTP API)
# In local Docker Compose: http://localhost:3001
# On VPS: http://<vps-ip>:3001
JUDGE_SERVICE_URL=http://localhost:3001

# Firebase Auth credentials (optional / if using Firebase auth)
FIREBASE_PROJECT_ID=kiln-detox
FIREBASE_API_KEY=AIzaSyBJtoeCAyc13oFz66UxIxGc2IkLc_8NW5k
