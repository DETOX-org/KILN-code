{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "engine": "judge0-ce",
  "engineVersion": "1.13.1",
  "isolateVersion": "1.10.1",
  "manifestVersion": "1.0.0",
  "description": "Pinned MVP compiler and interpreter runtime configurations for Judge0 CE in KILN / DETOX Code.",
  "runtimes": {
    "c": {
      "language": "c",
      "name": "C (GCC 10.2.0)",
      "judge0LanguageId": 51,
      "pinnedVersion": "10.2.0",
      "compiler": "gcc",
      "compileCommand": "gcc -O3 -std=c11 main.c",
      "versionCheck": {
        "code": "#include <stdio.h>\nint main() { printf(\"GCC %s\\n\", __VERSION__); return 0; }",
        "expectedVersionPattern": "10\\.2\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "cpp": {
      "language": "cpp",
      "name": "C++ (GCC 10.2.0)",
      "judge0LanguageId": 52,
      "pinnedVersion": "10.2.0",
      "compiler": "g++",
      "compileCommand": "g++ -O3 -std=c++17 main.cpp",
      "versionCheck": {
        "code": "#include <iostream>\nint main() { std::cout << \"GCC \" << __VERSION__ << std::endl; return 0; }",
        "expectedVersionPattern": "10\\.2\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "java": {
      "language": "java",
      "name": "Java (OpenJDK 15.0.2)",
      "judge0LanguageId": 91,
      "pinnedVersion": "15.0.2",
      "compiler": "javac",
      "compileCommand": "javac Main.java",
      "versionCheck": {
        "code": "public class Main { public static void main(String[] args) { System.out.println(\"Java \" + System.getProperty(\"java.version\")); } }",
        "expectedVersionPattern": "15\\.0\\.2"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 524288
      }
    },
    "python": {
      "language": "python",
      "name": "Python (3.10.0)",
      "judge0LanguageId": 92,
      "pinnedVersion": "3.10.0",
      "compiler": "python3",
      "compileCommand": null,
      "versionCheck": {
        "code": "import sys; print(f'Python {sys.version.split()[0]}')",
        "expectedVersionPattern": "3\\.10\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 262144
      }
    },
    "javascript": {
      "language": "javascript",
      "name": "JavaScript (Node.js 18.15.0)",
      "judge0LanguageId": 93,
      "pinnedVersion": "18.15.0",
      "compiler": "node",
      "compileCommand": null,
      "versionCheck": {
        "code": "console.log('Node.js ' + process.version);",
        "expectedVersionPattern": "18\\.15\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "typescript": {
      "language": "typescript",
      "name": "TypeScript (5.0.3)",
      "judge0LanguageId": 94,
      "pinnedVersion": "5.0.3",
      "compiler": "tsc",
      "compileCommand": "tsc --target ES2022",
      "versionCheck": {
        "code": "declare const process: { version: string }; console.log('TypeScript 5.0.3 on Node ' + process.version);",
        "expectedVersionPattern": "5\\.0\\.3"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 524288
      }
    },
    "sql": {
      "language": "sql",
      "name": "SQL (SQLite 3.27.2)",
      "judge0LanguageId": 82,
