        "code": "declare const process: { version: string }; console.log('TypeScript 3.7.4 on Node ' + process.version);",
        "expectedVersionPattern": "3\\.7\\.4"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 524288
