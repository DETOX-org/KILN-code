{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "engine": "judge0-ce",
  "engineVersion": "1.13.1",
  "isolateVersion": "1.10.1",
  "manifestVersion": "1.0.0",
  "description": "Pinned MVP compiler and interpreter runtime configurations for Judge0 CE in KILN / DETOX Code.",
  "runtimes": {
    "c": {
      "language": "c",
      "name": "C (GCC 9.2.0)",
      "judge0LanguageId": 50,
      "pinnedVersion": "9.2.0",
      "compiler": "gcc",
      "compileCommand": "gcc -O3 -std=c11 main.c",
      "versionCheck": {
        "code": "#include <stdio.h>\nint main() { printf(\"GCC %s\\n\", __VERSION__); return 0; }",
        "expectedVersionPattern": "9\\.2\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "cpp": {
      "language": "cpp",
      "name": "C++ (GCC 9.2.0)",
      "judge0LanguageId": 54,
      "pinnedVersion": "9.2.0",
      "compiler": "g++",
      "compileCommand": "g++ -O3 -std=c++17 main.cpp",
      "versionCheck": {
        "code": "#include <iostream>\nint main() { std::cout << \"GCC \" << __VERSION__ << std::endl; return 0; }",
        "expectedVersionPattern": "9\\.2\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "java": {
      "language": "java",
      "name": "Java (OpenJDK 13.0.1)",
      "judge0LanguageId": 62,
      "pinnedVersion": "13.0.1",
      "compiler": "javac",
      "compileCommand": "javac Main.java",
      "versionCheck": {
        "code": "public class Main { public static void main(String[] args) { System.out.println(\"Java \" + System.getProperty(\"java.version\")); } }",
        "expectedVersionPattern": "13\\.0\\.1"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 524288
      }
    },
    "python": {
      "language": "python",
      "name": "Python (3.8.1)",
      "judge0LanguageId": 71,
      "pinnedVersion": "3.8.1",
      "compiler": "python3",
      "compileCommand": null,
      "versionCheck": {
        "code": "import sys; print(f'Python {sys.version.split()[0]}')",
        "expectedVersionPattern": "3\\.8\\.1"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 3000,
        "wallTimeLimitMs": 6000,
        "memoryLimitKb": 262144
      }
    },
    "javascript": {
      "language": "javascript",
      "name": "JavaScript (Node.js 12.14.0)",
      "judge0LanguageId": 63,
      "pinnedVersion": "12.14.0",
      "compiler": "node",
      "compileCommand": null,
      "versionCheck": {
        "code": "console.log('Node.js ' + process.version);",
        "expectedVersionPattern": "12\\.14\\.0"
      },
      "defaultLimits": {
        "cpuTimeLimitMs": 2000,
        "wallTimeLimitMs": 4000,
        "memoryLimitKb": 262144
      }
    },
    "typescript": {
      "language": "typescript",
      "name": "TypeScript (3.7.4)",
      "judge0LanguageId": 74,
      "pinnedVersion": "3.7.4",
      "compiler": "tsc",
      "compileCommand": "tsc --target ES2022",
