{
  "name": "KILN-Code Design Tokens",
  "version": "1.1.0",
  "description": "Design tokens for DETOX / KILN Code platform incorporating grading types, subtasks, verification badges, and discrepancy states.",
  "color": {
    "neutral": {
      "ink": "#12181F",
      "paper": "#EFF2F6",
      "panel": "#FFFFFF",
      "sub": "#4B5768",
      "line": "#D7DEE7",
      "gutter": "#DDE3EC",
      "cardHover": "#F8FAFC"
    },
    "status": {
      "accepted": {
        "text": "#0E7A4C",
        "bg": "#E4F7EE",
        "border": "#A3E6C5",
        "solid": "#1AAE6F"
      },
      "wrongAnswer": {
        "text": "#B4272B",
        "bg": "#FCE7E8",
        "border": "#F8B4B7",
        "solid": "#E5484D"
      },
      "pending": {
        "text": "#8A5E0B",
        "bg": "#FDF3DC",
        "border": "#F8DF9E",
        "solid": "#E6A415"
      },
      "timeLimitExceeded": {
        "text": "#9A4B00",
        "bg": "#FFF1E5",
        "border": "#FDC79F",
        "solid": "#F76B15"
      },
      "memoryLimitExceeded": {
        "text": "#793392",
        "bg": "#F9EDFC",
        "border": "#E4B8F3",
        "solid": "#AB4ABA"
      },
      "judgeError": {
        "text": "#475569",
        "bg": "#F1F5F9",
        "border": "#CBD5E1",
        "solid": "#64748B"
      },
      "discrepancyFlagged": {
        "text": "#9A1F45",
        "bg": "#FDF0F3",
        "border": "#F8B6C7",
        "solid": "#D92D5B"
      }
    },
    "accent": {
      "violet": {
        "text": "#4338CA",
        "bg": "#EEF2FF",
        "border": "#C7D2FE",
        "solid": "#6366F1"
      },
      "verified": {
        "text": "#0D7A68",
        "bg": "#E6F8F4",
        "border": "#99E8D8",
        "solid": "#0EA5E9"
      },
      "cyan": {
        "text": "#0E7490",
        "bg": "#ECFEFF",
        "border": "#A5F3FC",
        "solid": "#06B6D4"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'IBM Plex Mono', 'SFMono-Regular', Consolas, Menlo, monospace"
    },
    "scale": {
      "display": { "fontSize": "32px", "lineHeight": "1.2", "fontWeight": "600", "letterSpacing": "-0.02em" },
      "h1": { "fontSize": "24px", "lineHeight": "1.25", "fontWeight": "600", "letterSpacing": "-0.01em" },
      "h2": { "fontSize": "20px", "lineHeight": "1.3", "fontWeight": "600", "letterSpacing": "-0.01em" },
      "h3": { "fontSize": "16px", "lineHeight": "1.4", "fontWeight": "600" },
      "body": { "fontSize": "14px", "lineHeight": "1.55", "fontWeight": "400" },
      "bodySmall": { "fontSize": "12.5px", "lineHeight": "1.5", "fontWeight": "400" },
      "caption": { "fontSize": "11px", "lineHeight": "1.4", "fontWeight": "500", "letterSpacing": "0.02em" },
      "monoCode": { "fontSize": "13px", "lineHeight": "1.6", "fontFamily": "mono" }
    }
  },
  "spacing": {
    "2xs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "xl": "14px",
    "pill": "9999px"
  },
  "gradingTypeOptions": [
    {
      "id": "standard_diff",
      "name": "Standard Diff (Exact / Whitespace Trim)",
      "description": "Output is compared directly against expected output with token/whitespace trimming. Ideal for algorithmic problems with unique deterministic outputs.",
      "defaultEngine": "judge0",
      "supportsSubtasks": false
    },
    {
      "id": "custom_checker",
      "name": "Custom Checker (Testlib / Special Judge)",
      "description": "Runs a custom checker program (e.g. Testlib-style in C++) to validate solutions where multiple valid outputs exist (e.g. float tolerances, arbitrary graph paths).",
      "defaultEngine": "judge0",
      "supportsSubtasks": false
    },
    {
      "id": "subtask_ioi",
      "name": "Subtask-Based (IOI / Partial Scoring)",
      "description": "Test cases are partitioned into distinct subtasks with constraints and point allocations. A subtask is awarded points only when all its constituent tests pass.",
      "defaultEngine": "judge0",
      "supportsSubtasks": true
    }
  ],
  "verificationAudit": {
    "scope": "Contest Finalization Only",
    "description": "Triggered exclusively for top-of-leaderboard submissions prior to finalizing prize-eligible contest rankings.",
    "engines": ["judge0 (Primary)", "piston (Verification)"],
    "badgeText": "Verified ✓",
    "badgeTooltip": "Audited & verified against dual execution engine during contest finalization."
  }
}
