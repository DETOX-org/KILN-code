# Generic .gitignore for DETOX Code repository

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Code Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.bak

# Environment and Local Configs
.env
.env.local
.env.*.local
*.local

# Logs and Crash Reports
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generic Build Outputs and Cache
dist/
build/
out/
bin/
obj/
.cache/
tmp/
temp/
coverage/

# Dependencies / Vendor directories (Generic placeholders)
node_modules/
vendor/
venv/
.venv/
__pycache__/
